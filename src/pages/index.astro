---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Button from '@/components/Button.astro';
import FAQAccordion from '@/components/islands/FAQAccordion';
import { generateOrganizationSchema, generateHowToSchema, generateWebSiteSchema, generateFAQSchema } from '@/lib/utils';

// Import optimized images
import peterDruckerImg from '@/assets/images/peter-drucker.jpg';
import sergeiImg from '@/assets/images/sergei.jpg';
import studentInterestsImg from '@/assets/images/student-interests.png';
import careerGrowthImg from '@/assets/images/career-growth.png';
import technologiesImg from '@/assets/images/technologies-illustration.png';
import reportPreview1Img from '@/assets/images/report-preview-1.png';
import reportPreview2Img from '@/assets/images/report-preview-2.png';
import reportPreview3Img from '@/assets/images/report-preview-3.png';

const faqItems = [
  {
    question: 'Сколько времени занимает прохождение теста?',
    answer: 'Прохождение теста занимает 10-15 минут. Отвечайте искренне, опираясь на первое впечатление — правильных или неправильных ответов не существует.'
  },
  {
    question: 'Когда я получу отчет?',
    answer: 'Обычно отчет приходит на email в течение 10 минут после оплаты. В редких случаях обработка может занять до 12 часов. Проверьте папку "Спам", если не видите письмо.'
  },
  {
    question: 'Чем ваш тест отличается от других?',
    answer: 'Наш тест основан на глубокой оценке склонностей и ценностей человека, что отвечает на вопрос, какие профессии максимально ему подойдут. При этом у нас отсутствуют тесты на логику или внимание, так как они только вносят дополнительный фактор неопределенности и искажают результат — ведь логику и внимание можно развить при наличии должной мотивации.'
  },
  {
    question: 'Какой тариф мне выбрать?',
    answer: 'Выбирайте тариф по возрасту и целям: "Школьники" (14–18 лет) — для выбора направления обучения после школы; "Взрослые" — для смены или развития карьеры. Все тесты научно обоснованы, различается глубина анализа и акценты на разных этапах жизни.'
  },
  {
    question: 'Насколько точны результаты теста?',
    answer: 'Точность результатов зависит от вашей честности при ответах. Тест основан на проверенных научных методиках (RIASEC и Климова), которые используются профориентологами по всему миру. При правдивых ответах точность составляет 80-90%.'
  },
  {
    question: 'Можно ли пройти тест повторно?',
    answer: 'Да, тест можно пройти повторно. Искусственный интеллект на основании вашего результата может предложить другой набор подходящих профессий, так как отчет ограничен 15–20 профессиями, в то время как человеку обычно может подходить до 200 различных профессий.'
  }
];

const jsonLd = [
  generateOrganizationSchema(),
  generateHowToSchema(),
  generateWebSiteSchema(),
  generateFAQSchema(faqItems),
];
---

<BaseLayout
  title="Тест на профориентацию онлайн за 15 минут"
  description="Получите детальный PDF-отчёт с топ-20 профессий под ваш профиль и план действий. Научные методики + анализ ИИ. Для взрослых и подростков."
  keywords="тест на профориентацию, профориентация онлайн, выбор профессии, тест на профессию, карьерная ориентация, профориентация для подростков, профориентация для взрослых, смена профессии, профориентационный тест, подбор профессии, RIASEC, тест Холланда"
  jsonLd={jsonLd}
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-background py-16 lg:py-24">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
            <!-- Image -->
            <div class="w-48 h-48 lg:w-56 lg:h-56 flex-shrink-0">
              <Image
                src={peterDruckerImg}
                alt="Питер Друкер - основатель современного менеджмента и теории профориентации"
                class="w-full h-full object-cover rounded-full border-4 border-primary/20 shadow-xl"
                width={224}
                height={224}
                loading="eager"
                fetchpriority="high"
                format="webp"
                quality={85}
              />
            </div>

            <!-- Content -->
            <div class="text-center lg:text-left flex-1">
              <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-text-primary mb-6">
                «Лучший способ предсказать будущее - создать его»
              </h1>
              <p class="text-xl lg:text-2xl text-text-secondary mb-4 italic">
                — Питер Друкер
              </p>
              <p class="text-lg lg:text-xl text-text-secondary mb-8 leading-relaxed">
                Научный подход к профориентации: тестирование за 10-15 минут, персональный отчет с рекомендациями профессий на основе ваших интересов, личности и ценностей
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <Button href="/tests" size="lg" variant="primary">
                  Начать тест
                </Button>
                <Button href="/about" size="lg" variant="outline">
                  Узнать больше
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Target Audience Section -->
    <section class="py-16 lg:py-24 bg-surface relative overflow-hidden">

      <div class="container-custom relative z-10">
        <div class="text-center mb-16">
          
          <h2 class="text-3xl lg:text-5xl font-bold text-text-primary mb-6">
            Подберем путь для каждого
          </h2>
          <p class="text-lg lg:text-xl text-text-secondary max-w-3xl mx-auto">
            Наша платформа помогает людям на разных этапах жизни найти свой профессиональный путь
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
          <!-- Подростки -->
          <a
            href="/tests"
            class="relative group bg-gradient-to-br from-blue-500/10 to-cyan-500/10 backdrop-blur-sm p-8 lg:p-10 rounded-2xl border-2 border-border hover:border-blue-500 hover:shadow-2xl transition-all duration-300 hover:-translate-y-3 block cursor-pointer"
          >
            <!-- Glow effect -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary/0 to-secondary/0 group-hover:from-primary/5 group-hover:to-secondary/5 rounded-2xl transition-all duration-300"></div>

            <div class="relative z-10">
              <div class="mb-8 flex justify-center">
                <div class="relative">
                  <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary opacity-20 rounded-2xl blur-xl group-hover:opacity-30 transition-opacity"></div>
                  <Image
                    src={studentInterestsImg}
                    alt="Профориентация Подростки 12-17 лет - тест на выбор профессии"
                    class="relative w-40 h-40 lg:w-48 lg:h-48 object-contain group-hover:scale-110 transition-transform duration-300 drop-shadow-lg"
                    width={192}
                    height={192}
                    loading="lazy"
                    format="webp"
                    quality={65}
                  />
                </div>
              </div>

              <h3 class="text-2xl lg:text-3xl font-bold text-text-primary mb-4 text-center group-hover:text-primary transition-colors">
                Подростки 12-17 лет
              </h3>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed text-center">
                Для выбора будущей профессии и планирования образовательного маршрута
              </p>
            </div>
          </a>

          <!-- Взрослые -->
          <a
            href="/tests"
            class="relative group bg-gradient-to-br from-purple-500/10 to-pink-500/10 backdrop-blur-sm p-8 lg:p-10 rounded-2xl border-2 border-border hover:border-purple-500 hover:shadow-2xl transition-all duration-300 hover:-translate-y-3 block cursor-pointer"
          >
            <!-- Glow effect -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary/0 to-secondary/0 group-hover:from-primary/5 group-hover:to-secondary/5 rounded-2xl transition-all duration-300"></div>

            <div class="relative z-10">
              <div class="mb-8 flex justify-center">
                <div class="relative">
                  <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary opacity-20 rounded-2xl blur-xl group-hover:opacity-30 transition-opacity"></div>
                  <Image
                    src={careerGrowthImg}
                    alt="Профориентация Взрослые и выпускники вузов - тест на выбор профессии"
                    class="relative w-40 h-40 lg:w-48 lg:h-48 object-contain group-hover:scale-110 transition-transform duration-300 drop-shadow-lg"
                    width={192}
                    height={192}
                    loading="lazy"
                    format="webp"
                    quality={65}
                  />
                </div>
              </div>

              <h3 class="text-2xl lg:text-3xl font-bold text-text-primary mb-4 text-center group-hover:text-primary transition-colors">
                Взрослые и выпускники вузов
              </h3>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed text-center">
                Для смены текущей профессиональной деятельности и поиска нового призвания
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Technologies Section -->
    <section class="py-16 lg:py-24 bg-background relative overflow-hidden">

      <div class="container-custom relative z-10">
        <div class="text-center mb-16">
          
          <h2 class="text-3xl lg:text-5xl font-bold text-text-primary mb-6">
            Наши технологии
          </h2>
          <p class="text-lg lg:text-xl text-text-secondary max-w-3xl mx-auto">
            Мы используем научно обоснованные методики профориентации, усиленные технологиями искусственного интеллекта и машинного обучения для максимально точных и персонализированных рекомендаций
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 max-w-6xl mx-auto mb-12">
          <!-- Illustration -->
          <div class="flex items-center justify-center order-2 lg:order-1">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-3xl blur-2xl"></div>
              <Image
                src={technologiesImg}
                alt="Научные методики профориентации: RIASEC, типология Климова, анализ личности и ИИ"
                class="relative w-full max-w-md mx-auto drop-shadow-2xl"
                width={448}
                height={448}
                loading="lazy"
                format="webp"
                quality={65}
              />
            </div>
          </div>

          <!-- Technologies Grid -->
          <div class="grid grid-cols-1 gap-6 order-1 lg:order-2">
            {[
              {
                title: 'RIASEC',
                description: 'Типология профессиональных интересов Холланда для точного определения склонностей и построения персонализированной карты профессиональных предпочтений',
                icon: '🧭',
                gradient: 'from-blue-500 to-cyan-500',
              },
              {
                title: 'Объекты деятельности Климова',
                description: 'Классификация профессий по предмету труда для выбора оптимального направления развития карьеры на основе индивидуальных способностей',
                icon: '🔍',
                gradient: 'from-purple-500 to-pink-500',
              },
              {
                title: 'Личностные качества',
                description: 'Комплексный анализ черт характера для соответствия требованиям профессии и формирования детального психологического профиля',
                icon: '🧠',
                gradient: 'from-green-500 to-emerald-500',
              },
              {
                title: 'Ценности',
                description: 'Определение важных для вас аспектов работы и карьеры для прогнозирования профессиональной удовлетворенности и построения устойчивой карьерной траектории',
                icon: '💎',
                gradient: 'from-orange-500 to-red-500',
              },
              {
                title: 'Интеграционный анализ с ИИ',
                description: 'Искусственный интеллект объединяет результаты всех методик выше и формирует целостный и персонализированный профессиональный профиль с учетом уникальных особенностей',
                icon: '🤖',
                gradient: 'from-indigo-500 to-purple-500',
              },
            ].map((tech) => (
              <div class="group relative bg-surface/80 backdrop-blur-sm p-6 rounded-xl border-2 border-border hover:border-transparent hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
                <!-- Gradient glow on hover -->
                <div class={`absolute inset-0 bg-gradient-to-br ${tech.gradient} opacity-0 group-hover:opacity-10 rounded-xl transition-opacity -z-10`}></div>

                <div class="flex items-start gap-4">
                  <div class={`w-12 h-12 bg-gradient-to-br ${tech.gradient} text-white rounded-lg flex items-center justify-center text-2xl flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform`}>
                    {tech.icon}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">{tech.title}</h3>
                    <p class="text-text-secondary text-sm leading-relaxed">{tech.description}</p>
                  </div>
                </div>

                <!-- Decorative corner accent -->
                <div class={`absolute bottom-0 right-0 w-20 h-20 bg-gradient-to-tl ${tech.gradient} opacity-0 group-hover:opacity-5 rounded-tl-full transition-opacity`}></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Story Section -->
    <section class="py-16 lg:py-24 bg-surface relative overflow-hidden">
      <!-- Decorative elements -->
      <div class="absolute top-1/4 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl"></div>

      <div class="container-custom relative z-10">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <!-- Photo -->
            <div class="lg:col-span-4 flex justify-center">
              <div class="relative group">
                <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary opacity-20 rounded-2xl blur-xl group-hover:opacity-30 transition-opacity"></div>
                <Image
                  src={sergeiImg}
                  alt="Сергей, сооснователь ProfReport - история смены профессии и создания сервиса профориентации"
                  class="relative w-80 h-80 lg:w-96 lg:h-96 object-cover object-top rounded-2xl shadow-lg border-4 border-surface"
                  width={384}
                  height={384}
                  loading="lazy"
                  format="webp"
                  quality={70}
                />
              </div>
            </div>

            <!-- Story Text -->
            <div class="lg:col-span-8 space-y-4">
              <p class="text-xl lg:text-2xl font-semibold text-primary">
                Привет!
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Меня зовут Сергей, и я сооснователь профориентационного сервиса ProfReport online.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Знаете, я потратил почти 20 лет своей жизни на то, чтобы понять одну простую вещь: я занимаюсь не тем.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                В детстве родители дали мне совет, который казался разумным: "Выбери профессию, которая точно принесет кусок хлеба". Я долго не знал, что выбрать, и они предложили связать жизнь с энергетикой — надежно, стабильно, всегда востребовано.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Я закончил техникум. Потом университет. Пошел работать по специальности. И все это время меня не увлекала ни учеба, ни та работа, которой я занимался. Совсем. Но я думал — так и должно быть. Работа есть работа, верно?
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Я менял одно место за другим. Каждый раз с надеждой, что вот здесь будет по-другому. И каждый раз задавал себе один и тот же вопрос: почему опять что-то не то? Почему я снова просыпаюсь с тяжестью, а не с предвкушением нового дня?
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Я искал проблему в себе. В коллегах. В условиях труда. В зарплате. В городе, в котором живу.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                А оказалось все гораздо проще — я просто занимался не своим делом. Все эти годы.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Осознание пришло только в 35 лет, когда я случайно попал в команду, которая разрабатывала новый IT-продукт. И впервые за всю свою профессиональную жизнь я почувствовал — вот оно! Я просыпаюсь и хочу работать. Мне интересно. У меня появляется энергия, а не исчезает. То, что я делаю, имеет смысл — для меня лично.
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                Мы создали ProfReport online именно для того, чтобы вы не потеряли 20 лет своей жизни, как я. Чтобы вы не шли методом проб и ошибок через выгорание, разочарование и вопрос "Неужели так будет всегда?".
              </p>

              <p class="text-base lg:text-lg text-text-secondary leading-relaxed">
                С помощью нашего сервиса вы сможете выбрать профессию, которая действительно соответствует вашим интересам и ценностям. Не тому, что "надо" или "престижно". Не тому, что посоветовали родители или друзья. А тому, что откликается именно вам.
              </p>

              <p class="text-base lg:text-lg font-semibold text-primary leading-relaxed">
                Давайте вместе найдем ваш путь — и сделаем это сейчас, а не через 20 лет.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Steps Section -->
    <section class="py-16 lg:py-24 bg-background relative overflow-hidden">

      <div class="container-custom relative z-10">
        <div class="text-center mb-16">
          
          <h2 class="text-3xl lg:text-5xl font-bold text-text-primary mb-6">
            Путь к вашей профессии
          </h2>
          <p class="text-lg lg:text-xl text-text-secondary max-w-3xl mx-auto">
            Всего 4 простых шага отделяют вас от профессионального отчета о вашем призвании
          </p>
        </div>

        <!-- Progress bar -->
        <div class="max-w-5xl mx-auto mb-16">
          <div class="relative">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-0 relative">
              {[
                {
                  number: '1',
                  title: 'Выберите тест',
                  description: 'Выберите интересующий вас тест',
                  icon: '🎯',
                  gradient: 'from-blue-500 to-cyan-500',
                },
                {
                  number: '2',
                  title: 'Ответьте на вопросы',
                  description: 'Пройдите тест за 10-15 минут, отвечая честно на все вопросы',
                  icon: '✍️',
                  gradient: 'from-purple-500 to-pink-500',
                },
                {
                  number: '3',
                  title: 'Оплатите тест',
                  description: 'Оплатите выбранный тест в отдельном окне',
                  icon: '💳',
                  gradient: 'from-green-500 to-emerald-500',
                },
                {
                  number: '4',
                  title: 'Получите отчет',
                  description: 'Отчет придет на почту обычно в течение 10 минут, максимум — 12 часов',
                  icon: '📧',
                  gradient: 'from-orange-500 to-red-500',
                }
              ].map((step, index) => (
                <div class="relative flex flex-col items-center text-center group">
                  <!-- Connector arrow (only between steps on desktop) -->
                  {index < 3 && (
                    <div class="hidden lg:block absolute top-8 left-1/2 w-full h-0.5 pointer-events-none">
                      <svg class="absolute left-full top-1/2 -translate-y-1/2 -ml-3 w-6 h-6 text-primary opacity-0 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
                      </svg>
                    </div>
                  )}

                  <!-- Step circle with icon -->
                  <div class="relative mb-6">
                    <div class={`w-20 h-20 lg:w-24 lg:h-24 bg-gradient-to-br ${step.gradient} rounded-full flex items-center justify-center text-4xl lg:text-5xl shadow-lg relative z-10 group-hover:scale-110 transition-transform duration-300`}>
                      {step.icon}
                    </div>
                    <!-- Glow effect -->
                    <div class={`absolute inset-0 bg-gradient-to-br ${step.gradient} rounded-full blur-xl opacity-0 group-hover:opacity-50 transition-opacity duration-300`}></div>
                  </div>

                  <!-- Content -->
                  <div class="max-w-xs">
                    <h3 class="text-xl lg:text-2xl font-bold text-text-primary mb-3 group-hover:text-primary transition-colors">
                      {step.title}
                    </h3>
                    <p class="text-sm lg:text-base text-text-secondary leading-relaxed">
                      {step.description}
                    </p>
                  </div>

                  <!-- Mobile connector -->
                  {index < 3 && (
                    <div class="lg:hidden flex justify-center my-6">
