---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Button from '@/components/Button.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import FAQAccordion from '@/components/islands/FAQAccordion';
import { generateFAQSchema, generateBreadcrumbSchema } from '@/lib/utils';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'FAQ', url: '/faq' },
];

const faqItems = [
  {
    question: 'Сколько времени занимает прохождение теста?',
    answer: 'Прохождение теста занимает 10-15 минут. Отвечайте искренне, опираясь на первое впечатление — правильных или неправильных ответов не существует.'
  },
  {
    question: 'Почему именно такие вопросы входят в тест?',
    answer: 'Самое главное в обучении профессии — мотивация. Знания можно подтянуть при подготовке, а вот желание обучаться именно на этой профессии не появляется в процессе. Поэтому наш тест дает полное понимание о склонностях человека и его ценностях. Именно сочетание этого дает понимание, какую профессию выбрать.'
  },
  {
    question: 'Когда я получу отчет?',
    answer: 'Обычно отчет приходит на email в течение 10 минут после оплаты. В редких случаях обработка может занять до 12 часов. Проверьте папку "Спам", если не видите письмо.'
  },
  {
    question: 'Чем ваш тест отличается от других?',
    answer: 'Наш тест основан на глубокой оценке склонностей и ценностей человека, что отвечает на вопрос, какие профессии максимально ему подойдут. При этом у нас отсутствуют тесты на логику или внимание, так как они только вносят дополнительный фактор неопределенности и искажают результат — ведь логику и внимание можно развить при наличии должной мотивации.'
  },
  {
    question: 'Какой тариф мне выбрать?',
    answer: 'Выбирайте тариф по возрасту и целям: "Школьники" (14–18 лет) — для выбора направления обучения после школы; "Взрослые" — для смены или развития карьеры. Все тесты научно обоснованы, различается глубина анализа и акценты на разных этапах жизни.'
  },
  {
    question: 'Как вы обрабатываете мои данные?',
    answer: 'Мы обрабатываем ваши ответы исключительно для формирования персонального отчета. Данные хранятся в зашифрованном виде и не передаются третьим лицам. Подробнее в Политике конфиденциальности.'
  },
  {
    question: 'Нужна ли регистрация?',
    answer: 'Нет, регистрация не требуется. Вы проходите тест, указываете email для получения отчета и оплачиваете — всё. Личный кабинет не предусмотрен для упрощения процесса.'
  },
  {
    question: 'Можно ли пройти тест повторно?',
    answer: 'Да, тест можно пройти повторно. Искусственный интеллект на основании вашего результата может предложить другой набор подходящих профессий, так как отчет ограничен 15–20 профессиями, в то время как человеку обычно может подходить до 200 различных профессий.'
  },
  {
    question: 'Что делать, если отчет не пришел?',
    answer: 'Проверьте папку "Спам" в вашем почтовом ящике. Если письмо не пришло в течение 12 часов, напишите нам на info@profreport.online, указав email, который вы использовали при оплате.'
  },
  {
    question: 'Насколько точны результаты теста?',
    answer: 'Точность результатов зависит от вашей честности при ответах. Тест основан на проверенных научных методиках (RIASEC и Климова), которые используются профориентологами по всему миру. При правдивых ответах точность составляет 80-90%.'
  },
  {
    question: 'Можно ли получить возврат средств?',
    answer: 'Да, возврат возможен в случае, если отчет не пришел или пришел в нечитаемом виде. Напишите нам на info@profreport.online для оформления возврата.'
  },
  {
    question: 'Какие способы оплаты доступны?',
    answer: 'Мы принимаем оплату банковскими картами (Visa, MasterCard, МИР), электронными кошельками и через систему быстрых платежей (СБП). Оплата проходит через защищенный платежный шлюз.'
  },
  {
    question: 'Можно ли проходить тест с мобильного телефона?',
    answer: 'Да, сайт полностью адаптирован для мобильных устройств. Вы можете проходить тест с телефона, планшета или компьютера — результат будет одинаково точным.'
  },
  {
    question: 'Сохраняются ли мои ответы, если я закрою страницу?',
    answer: 'Нет, при закрытии страницы ответы не сохраняются. Рекомендуем пройти тест за один сеанс (это займет всего 10-15 минут), чтобы не потерять прогресс.'
  },
  {
    question: 'Что входит в персональный отчет?',
    answer: 'Отчет включает: анализ вашей личности по 4 методикам, список 15-20 подходящих профессий с описанием, ваши сильные и слабые стороны, рекомендации по развитию навыков и план действий для смены или выбора профессии.'
  },
  {
    question: 'Нужны ли специальные знания для прохождения теста?',
    answer: 'Нет, тест не требует специальных знаний. Вопросы касаются ваших интересов, ценностей и личных качеств. Отвечайте интуитивно, опираясь на первое впечатление.'
  },
  {
    question: 'Как часто можно проходить тест?',
    answer: 'Вы можете проходить тест несколько раз для получения более широкого списка подходящих профессий. Каждый раз искусственный интеллект может предложить новый набор профессий из сотен возможных вариантов.'
  },
  {
    question: 'Можно ли поделиться результатами с карьерным консультантом?',
    answer: 'Да, отчет приходит в формате PDF, который вы можете отправить карьерному консультанту, психологу или другим специалистам. Многие консультанты используют наши отчеты как основу для работы.'
  },
  {
    question: 'Есть ли у вас консультации с экспертами?',
    answer: 'В данный момент мы предоставляем только автоматизированные отчеты на основе ИИ. Однако в отчете есть подробные рекомендации, которые можно обсудить с любым карьерным консультантом или психологом.'
  }
];

const jsonLd = [
  generateFAQSchema(faqItems),
  generateBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout
  title="Часто задаваемые вопросы"
  description="Ответы на популярные вопросы о тестировании и отчетах ProfReport. Время прохождения, научность методик, возврат средств."
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom text-center">
        <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
          Часто задаваемые вопросы
        </h1>
        <p class="text-lg text-text-secondary max-w-3xl mx-auto">
          Ответы на популярные вопросы о тестировании и отчетах
        </p>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <FAQAccordion client:idle items={faqItems} />
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-20 bg-surface">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center bg-gradient-to-br from-primary/5 to-secondary/5 p-8 lg:p-12 rounded-lg border border-border">
          <h2 class="text-3xl font-bold text-text-primary mb-4">
            Не нашли ответ?
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Напишите нам на info@profreport.online, и мы ответим в течение 24 часов
          </p>
          <Button href="/contacts" size="lg" variant="primary">
            Написать нам
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
