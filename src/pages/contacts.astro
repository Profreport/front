---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { generateBreadcrumbSchema } from '@/lib/utils';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Контакты', url: '/contacts' },
];
---

<BaseLayout
  title="Контакты"
  description="Свяжитесь с нами по вопросам работы сервиса и сотрудничества."
  jsonLd={generateBreadcrumbSchema(breadcrumbs)}
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom text-center">
        <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
          Контакты
        </h1>
        <p class="text-lg text-text-secondary max-w-3xl mx-auto">
          Свяжитесь с нами по любым вопросам
        </p>
      </div>
    </section>

    <!-- Contact Info -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto">
          <div class="bg-surface p-8 rounded-lg border border-border shadow-sm">
            <p class="text-lg text-text-secondary leading-relaxed">
              При возникновении любых вопросов по работе сервиса, а также по вопросам сотрудничества обращайтесь на почту
              <a href="mailto:info@profreport.online" class="text-primary hover:underline font-semibold">
                info@profreport.online
              </a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
