---
export const prerender = false; // Enable SSR for pagination

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { generateBreadcrumbSchema } from '@/lib/utils';
import itProfessions from '@/data/it-professions';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профессии', url: '/professions' },
  { name: 'Профессии в IT', url: '/professions/it' },
];

// Filter out hidden professions
const visibleProfessions = itProfessions.filter(p => !p.hidden);

// Pagination
const perPage = 25;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const totalCount = visibleProfessions.length;
const totalPages = Math.ceil(totalCount / perPage);

const startIndex = (currentPage - 1) * perPage;
const endIndex = startIndex + perPage;
const professions = visibleProfessions.slice(startIndex, endIndex);

// Helper to generate page numbers with ellipsis
function getPageNumbers(current: number, total: number): number[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const pages: number[] = [1];

  if (current > 3) pages.push(-1);

  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) {
    pages.push(i);
  }

  if (current < total - 2) pages.push(-1);

  if (total > 1) pages.push(total);

  return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

<BaseLayout
  title="Профессии в IT - Обзор IT-специальностей"
  description="Востребованные IT-специальности: разработка, дизайн, аналитика, тестирование. Подробные описания и требования к IT-профессиям."
  jsonLd={generateBreadcrumbSchema(breadcrumbs)}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom">
        <div class="text-center mb-8">
          <div class="mb-6">
            <img src="/images/prof2.jpg" alt="Профессии в IT" class="w-32 h-32 mx-auto object-contain" />
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
            Профессии в IT
          </h1>
          <p class="text-lg text-text-secondary max-w-3xl mx-auto">
            Востребованные IT-специальности: разработка, дизайн, аналитика, тестирование и другие направления в сфере информационных технологий.
          </p>
          <p class="text-sm text-text-secondary mt-4">
            {currentPage > 1 ? `Страница ${currentPage} из ${totalPages}` : `Всего профессий: ${totalCount}`}
          </p>
        </div>
      </div>
    </section>

    <!-- Professions Grid -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6">
          {professions.map((profession) => (
            <a
              href={`/professions/it/${profession.id}`}
              class="group bg-surface rounded-lg border-2 border-border hover:border-primary hover:shadow-xl p-6 flex flex-col transition-all transform hover:-translate-y-1 w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] xl:w-[calc(20%-19.2px)] max-w-[220px]"
            >
              <!-- Image Placeholder -->
              <div class="mb-4 aspect-square bg-primary/5 rounded-lg flex items-center justify-center overflow-hidden">
                <img
                  src={profession.image}
                  alt={profession.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <!-- Title -->
              <h3 class="text-lg font-bold text-text-primary text-center group-hover:text-primary transition-colors">
                {profession.title}
              </h3>
            </a>
          ))}
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <div class="mt-12 flex justify-center gap-2 flex-wrap">
            {/* Previous Button */}
            {currentPage > 1 && (
              <a
                href={`/professions/it?page=${currentPage - 1}`}
                class="px-4 py-2 border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary hover:text-white transition-all"
              >
                ← Назад
              </a>
            )}

            {/* Page Numbers */}
            {pageNumbers.map((page) => (
              page === -1 ? (
                <span class="px-4 py-2 text-text-secondary">...</span>
              ) : (
                <a
                  href={`/professions/it?page=${page}`}
                  class:list={[
                    'px-4 py-2 font-semibold rounded-md transition-all',
                    page === currentPage
                      ? 'bg-primary text-white'
                      : 'border-2 border-border text-text-primary hover:border-primary hover:text-primary'
                  ]}
                >
                  {page}
                </a>
              )
            ))}

            {/* Next Button */}
            {currentPage < totalPages && (
              <a
                href={`/professions/it?page=${currentPage + 1}`}
                class="px-4 py-2 border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary hover:text-white transition-all"
              >
                Далее →
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- IT Industry Info -->
    <section class="py-16 bg-gradient-to-br from-blue-50 to-purple-50">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-text-primary mb-8 text-center">
            Почему IT-сфера?
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">📈</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Высокий спрос</h3>
              <p class="text-text-secondary">
                IT-специалисты востребованы на рынке труда во всем мире
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">💰</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Достойная оплата</h3>
              <p class="text-text-secondary">
                Конкурентные зарплаты и возможность удаленной работы
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">🚀</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Развитие</h3>
              <p class="text-text-secondary">
                Постоянное обучение и карьерный рост в динамичной сфере
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-primary/5">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-text-primary mb-6">
            Узнайте, какие IT-профессии вам подходят
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Наш тест на профориентацию поможет определить ваши сильные стороны и подобрать подходящие направления в IT.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/tests"
              class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-md hover:opacity-90 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              Пройти тест
            </a>
            <a
              href="/professions"
              class="inline-flex items-center justify-center px-8 py-4 bg-surface border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary/5 transition-all"
            >
              Все категории профессий
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
