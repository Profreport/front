---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { generateBreadcrumbSchema } from '@/lib/utils';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профессии', url: '/professions' },
  { name: 'Атлас новых профессий', url: '/professions/new' },
];

// Placeholder для будущего списка профессий
// TODO: Добавить реальные данные о профессиях будущего
const professions = [
  // Здесь будет список профессий будущего
];
---

<BaseLayout
  title="Атлас новых профессий - Профессии будущего"
  description="Профессии будущего, которые появятся или станут актуальными в ближайшие годы. Узнайте о перспективных специальностях."
  jsonLd={generateBreadcrumbSchema(breadcrumbs)}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom">
        <div class="text-center mb-8">
          <div class="mb-6">
            <img src="/images/prof3.png" alt="Атлас новых профессий" class="w-32 h-32 mx-auto object-contain" />
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
            Атлас новых профессий
          </h1>
          <p class="text-lg text-text-secondary max-w-3xl mx-auto">
            Профессии будущего, которые появятся или станут актуальными в ближайшие годы. Готовьтесь к карьере в инновационных отраслях.
          </p>
        </div>
      </div>
    </section>

    <!-- Professions List Section -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        {professions.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {/* Здесь будут карточки профессий будущего */}
          </div>
        ) : (
          <div class="max-w-2xl mx-auto text-center">
            <div class="bg-surface rounded-lg border-2 border-border p-12">
              <svg class="w-24 h-24 mx-auto mb-6 text-text-secondary opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              <h2 class="text-2xl font-bold text-text-primary mb-4">
                Список профессий будущего в разработке
              </h2>
              <p class="text-text-secondary mb-8">
                Мы работаем над подробным описанием перспективных профессий. Скоро здесь появится полный атлас специальностей будущего с требованиями, прогнозами и возможностями.
              </p>
              <a
                href="/tests"
                class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary-hover transition-all hover:shadow-md"
              >
                Пройти тест на профориентацию
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Future Trends -->
    <section class="py-16 bg-gradient-to-br from-purple-50 to-pink-50">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-text-primary mb-8 text-center">
            Тренды будущего
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">🤖</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Искусственный интеллект</h3>
              <p class="text-text-secondary">
                Профессии, связанные с разработкой и применением AI-технологий
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">🌱</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Зеленая экономика</h3>
              <p class="text-text-secondary">
                Специальности в области экологии и устойчивого развития
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">🏥</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Биотехнологии</h3>
              <p class="text-text-secondary">
                Инновационные направления в медицине и биоинженерии
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <div class="text-4xl mb-4">🌐</div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Цифровизация</h3>
              <p class="text-text-secondary">
                Профессии на стыке технологий и традиционных отраслей
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-primary/5">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-text-primary mb-6">
            Подготовьтесь к профессиям будущего
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Пройдите тест на профориентацию и узнайте, какие новые профессии соответствуют вашим способностям и интересам.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/tests"
              class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-md hover:opacity-90 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              Пройти тест
            </a>
            <a
              href="/professions"
              class="inline-flex items-center justify-center px-8 py-4 bg-surface border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary/5 transition-all"
            >
              Все категории профессий
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
