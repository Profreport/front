---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { generateBreadcrumbSchema } from '@/lib/utils';
import { getProfessionPage, getTotalPages, getTotalProfessions } from '@/data/professions';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профессии', url: '/professions' },
  { name: 'Общие профессии', url: '/professions/general' },
];

// Пагинация
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const perPage = 25; // 5x5
const professions = getProfessionPage(currentPage, perPage);
const totalPages = getTotalPages(perPage);
const totalCount = getTotalProfessions();

// Генерация номеров страниц для отображения
function getPageNumbers(current: number, total: number): number[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, 5, -1, total];
  }

  if (current >= total - 2) {
    return [1, -1, total - 4, total - 3, total - 2, total - 1, total];
  }

  return [1, -1, current - 1, current, current + 1, -1, total];
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

<BaseLayout
  title={currentPage > 1 ? `Общие профессии - Страница ${currentPage} из ${totalPages}` : "Общие профессии - Обзор специальностей"}
  description="Широкий спектр профессий в различных сферах деятельности. Подробные описания специальностей и требования."
  jsonLd={generateBreadcrumbSchema(breadcrumbs)}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom">
        <div class="text-center mb-8">
          <div class="mb-6">
            <img src="/images/Prof1.jpg" alt="Общие профессии" class="w-32 h-32 mx-auto object-contain" />
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
            Общие профессии
          </h1>
          <p class="text-lg text-text-secondary max-w-3xl mx-auto">
            Широкий спектр профессий в различных сферах деятельности. От традиционных до современных специальностей.
          </p>
          <p class="text-sm text-text-secondary mt-4">
            {currentPage > 1 ? `Страница ${currentPage} из ${totalPages}` : `Всего профессий: ${totalCount}`}
          </p>
        </div>
      </div>
    </section>

    <!-- Professions Grid -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6">
          {professions.map((profession) => (
            <a
              href={`/professions/general/${profession.id}`}
              class="group bg-surface rounded-lg border-2 border-border hover:border-primary hover:shadow-xl p-6 flex flex-col transition-all transform hover:-translate-y-1 w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] xl:w-[calc(20%-19.2px)] max-w-[220px]"
            >
              <!-- Image Placeholder -->
              <div class="mb-4 aspect-square bg-primary/5 rounded-lg flex items-center justify-center overflow-hidden">
                <img
                  src={profession.image}
                  alt={profession.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <!-- Title -->
              <h3 class="text-lg font-bold text-text-primary text-center group-hover:text-primary transition-colors">
                {profession.title}
              </h3>
            </a>
          ))}
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <div class="mt-12 flex justify-center gap-2 flex-wrap">
            {/* Previous Button */}
            {currentPage > 1 && (
              <a
                href={`/professions/general?page=${currentPage - 1}`}
                class="px-4 py-2 border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary hover:text-white transition-all"
              >
                ← Назад
              </a>
            )}

            {/* Page Numbers */}
            {pageNumbers.map((page) => (
              page === -1 ? (
                <span class="px-4 py-2 text-text-secondary">...</span>
              ) : (
                <a
                  href={`/professions/general?page=${page}`}
                  class:list={[
                    'px-4 py-2 font-semibold rounded-md transition-all',
                    page === currentPage
                      ? 'bg-primary text-white'
                      : 'border-2 border-border text-text-primary hover:border-primary hover:text-primary'
                  ]}
                >
                  {page}
                </a>
              )
            ))}

            {/* Next Button */}
            {currentPage < totalPages && (
              <a
                href={`/professions/general?page=${currentPage + 1}`}
                class="px-4 py-2 border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary hover:text-white transition-all"
              >
                Далее →
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-primary/5">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-text-primary mb-6">
            Узнайте, какие профессии вам подходят
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Наш тест на профориентацию поможет определить ваши сильные стороны и подобрать подходящие направления карьеры.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/tests"
              class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-md hover:opacity-90 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              Пройти тест
            </a>
            <a
              href="/professions"
              class="inline-flex items-center justify-center px-8 py-4 bg-surface border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary/5 transition-all"
            >
              Все категории профессий
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Прокрутка вверх при переходе между страницами
  document.addEventListener('astro:page-load', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('page')) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
</script>
