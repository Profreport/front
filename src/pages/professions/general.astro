---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { generateBreadcrumbSchema } from '@/lib/utils';

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профессии', url: '/professions' },
  { name: 'Общие профессии', url: '/professions/general' },
];

// Placeholder для будущего списка профессий
// TODO: Добавить реальные данные о профессиях
const professions = [
  // Здесь будет список профессий
];
---

<BaseLayout
  title="Общие профессии - Обзор специальностей"
  description="Широкий спектр профессий в различных сферах деятельности. Подробные описания специальностей и требования."
  jsonLd={generateBreadcrumbSchema(breadcrumbs)}
>
  <Header />
  <Breadcrumb items={breadcrumbs} />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary/5 to-secondary/5 py-12 lg:py-16">
      <div class="container-custom">
        <div class="text-center mb-8">
          <div class="mb-6">
            <img src="/images/Prof1.png" alt="Общие профессии" class="w-32 h-32 mx-auto object-contain" />
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-4">
            Общие профессии
          </h1>
          <p class="text-lg text-text-secondary max-w-3xl mx-auto">
            Широкий спектр профессий в различных сферах деятельности. От традиционных до современных специальностей.
          </p>
        </div>
      </div>
    </section>

    <!-- Professions List Section -->
    <section class="py-16 lg:py-24 bg-background">
      <div class="container-custom">
        {professions.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {/* Здесь будут карточки профессий */}
          </div>
        ) : (
          <div class="max-w-2xl mx-auto text-center">
            <div class="bg-surface rounded-lg border-2 border-border p-12">
              <svg class="w-24 h-24 mx-auto mb-6 text-text-secondary opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              <h2 class="text-2xl font-bold text-text-primary mb-4">
                Список профессий в разработке
              </h2>
              <p class="text-text-secondary mb-8">
                Мы работаем над подробным описанием профессий. Скоро здесь появится полный каталог специальностей с требованиями, перспективами и рекомендациями.
              </p>
              <a
                href="/tests"
                class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary-hover transition-all hover:shadow-md"
              >
                Пройти тест на профориентацию
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-primary/5">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-text-primary mb-6">
            Узнайте, какие профессии вам подходят
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Наш тест на профориентацию поможет определить ваши сильные стороны и подобрать подходящие направления карьеры.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/tests"
              class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-semibold rounded-md hover:opacity-90 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              Пройти тест
            </a>
            <a
              href="/professions"
              class="inline-flex items-center justify-center px-8 py-4 bg-surface border-2 border-primary text-primary font-semibold rounded-md hover:bg-primary/5 transition-all"
            >
              Все категории профессий
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
